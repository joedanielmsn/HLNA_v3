pkgname=hlna
pkgver=0.1.0
pkgrel=1
pkgdesc="HLNA desktop assistant preview (Jan desktop foundation)"
arch=('x86_64')
url="https://github.com/joedanielmsn/HLNA_v3"
license=('custom')
depends=('fuse2' 'vulkan-icd-loader')
optdepends=('nvidia-utils: NVIDIA Vulkan/CUDA driver support')
source=('HLNA.AppImage' 'hlna.desktop' 'hlna.svg' 'hlna-launcher.sh')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 "$srcdir/HLNA.AppImage" "$pkgdir/opt/hlna/HLNA.AppImage"
  install -Dm755 "$srcdir/hlna-launcher.sh" "$pkgdir/usr/bin/hlna"
  install -Dm644 "$srcdir/hlna.desktop" "$pkgdir/usr/share/applications/hlna.desktop"
  install -Dm644 "$srcdir/hlna.svg" "$pkgdir/usr/share/pixmaps/hlna.svg"
  install -Dm644 "$srcdir/hlna.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/hlna.svg"
}
